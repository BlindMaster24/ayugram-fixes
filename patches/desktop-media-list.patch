+QAccessible::Role ListWidget::accessibilityRole() {
+	return QAccessible::List;
+}
+
+QString ListWidget::accessibilityName() {
+	return QString();
+}
+
+int ListWidget::accessibilityChildCount() const {
+	auto result = 0;
+	for (const auto &section : _sections) {
+		result += int(section.items().size());
+	}
+	return result;
+}
+
+QAccessible::Role ListWidget::accessibilityChildRole() const {
+	return QAccessible::ListItem;
+}
+
+QString ListWidget::accessibilityChildName(int index) const {
+	const auto item = itemAtIndex(index);
+	if (!item) {
+		return {};
+	}
+	const auto document = item->getDocument();
+	if (!document) {
+		return tr::lng_media_photo_title(tr::now);
+	}
+	const auto name = document->filename();
+	return name.isEmpty() ? tr::lng_media_video(tr::now) : name;
+}
+
+QRect ListWidget::accessibilityChildRect(int index) const {
+	return itemRectAtIndex(index);
+}
+
+BaseLayout *ListWidget::itemAtIndex(int index) const {
+	auto currentIndex = 0;
+	for (const auto &section : _sections) {
+		for (const auto &item : section.items()) {
+			if (currentIndex == index) {
+				return item;
+			}
+			++currentIndex;
+		}
+	}
+	return nullptr;
+}
+
+QRect ListWidget::itemRectAtIndex(int index) const {
+	auto currentIndex = 0;
+	for (const auto &section : _sections) {
+		for (const auto &item : section.items()) {
+			if (currentIndex == index) {
+				return section.findItemDetails(item).geometry;
+			}
+			++currentIndex;
+		}
+	}
+	return QRect();
+}
